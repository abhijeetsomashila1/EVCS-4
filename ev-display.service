[Unit]
Description=EV Charger 7-inch Display & Monitor Service
After=graphical.target network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/EVCS-4
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 /home/evcharger/EVCS-4/Charger_script.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target